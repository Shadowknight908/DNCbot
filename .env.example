# Copy this file to `.env` and fill in real values.

# From https://discord.com/developers/applications -> your bot -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_token

# LLM provider API key (used for chat, vision, archivist, and GM calls)
# Default provider is OpenRouter — get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_key

# Embeddings API key (optional — falls back to OPENROUTER_API_KEY if not set)
# Set this if you use a separate provider for embeddings (e.g. a self-hosted model)
EMBEDDING_API_KEY=

# Tavily Search API key (optional — enables web search in chat/chatuc modes)
# Get a key at https://app.tavily.com
TAVILY_API_KEY=
